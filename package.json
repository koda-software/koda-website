{
  "name": "opero-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "next dev -p 3003",
    "build": "next build --webpack",
    "postbuild": "next-sitemap",
    "preview": "next start -p 3004",
    "lint": "eslint",
    "typegen": "next typegen",
    "type-check": "tsc --noEmit --incremental false",
    "quality:nonvisual": "node scripts/quality-nonvisual.mjs",
    "quality:lighthouse": "node scripts/quality-lighthouse.mjs",
    "quality:precommit": "npm run typegen && npm run type-check && npm run lint"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "country-flag-icons": "^1.6.17",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.0.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "lighthouse": "^12.8.2",
    "next-sitemap": "^4.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
