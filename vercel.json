{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "(^|.*,\\s*)pl(?:-|;|,|$).*"
        }
      ],
      "destination": "/pl",
      "permanent": false
    }
  ]
}
